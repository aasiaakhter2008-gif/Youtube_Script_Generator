{$DOMAIN} {
	encode zstd gzip

	# Backend API
	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /health/* {
		reverse_proxy api:8000
	}
	handle /docs {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Everything else -> Next.js frontend
	handle {
		reverse_proxy web:3000
	}
}
