# ==========================================================================
# Production environment for YouTube Script Generator
# Copy to .env.production (NEVER commit the real file):
#   cp .env.production.example .env.production
#   nano .env.production
# Compose command:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ==========================================================================

# ---- Domain (Caddy auto-HTTPS) --------------------------------------------
DOMAIN=app.example.com

# ---- Runtime ----------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# ---- API key (REQUIRED, >= 32 random chars) ---------------------------------
# Generate: python scripts/generate_secret.py
# App refuses to boot in production if this is empty/default/< 32 chars.
API_KEY=

# CORS: exact public origin(s), comma-separated. Never "*".
# Free split deployment: https://your-app.vercel.app
# VPS single-domain: https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Database (PostgreSQL inside compose; SQLite is dev-only) ---------------
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+asyncpg://ysg:change-me-to-a-long-random-password@db:5432/ysg

# ---- LLM provider (Gemini via Google AI Studio) ------------------------------
# Free tier: fallback chain keeps working on 503/429 with the lightest models last.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# Strongest free model first; chain falls back to Flash-Lite when quota runs out.
GEMINI_MODEL_WRITER=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash-lite
# Optional second FREE provider (skip when empty): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Anthropic fallback (if you also have Claude quota)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_OUTLINE_MODEL=claude-3-haiku-20240307
LLM_CRITIC_MODEL=claude-3-haiku-20240307
LLM_WRITER_MODEL=claude-sonnet-4-20250514

# ---- Gemini embeddings (voice profiles / competitor analysis / trends) -----
EMBEDDING_MODEL=gemini-embedding-2

# ---- Qdrant Cloud (leave URL empty to use in-memory storage) ----------------
# Qdrant Cloud -> Clusters -> <your cluster> -> API Keys
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=ysg

# ---- Generation tuning --------------------------------------------------------
TEMPERATURE=0.7
MAX_REVISIONS=2
CRITIC_PASS_THRESHOLD=8.0
TARGET_WPM=140
AGENT_TIMEOUT_SECONDS=300
LLM_REQUESTS_PER_MINUTE=8
LLM_MAX_CONCURRENCY=2
LLM_CACHE_TTL_SECONDS=3600
GEMINI_REQUEST_TIMEOUT_SECONDS=90

# ---- Free-tier guards ----------------------------------------------------------
# Generations per API-key owner per UTC day (0 = unlimited).
GENERATION_DAILY_LIMIT_PER_USER=20

# ---- TTS provider ------------------------------------------------------------
# elevenlabs (requires ELEVENLABS_API_KEY) | edge (free local, requires: pip install edge-tts)
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
TTS_VOICE=en-US-AriaNeural

# ---- Stripe billing ----------------------------------------------------------
STRIPE_API_KEY=

# ---- Translation / dubbing ----------------------------------------------------
SUPPORTED_LANGUAGES=English,Urdu,Roman Urdu,Hindi,Arabic,Spanish

# ---- Observability ------------------------------------------------------------
# Optional: JSON logs shipped to Sentry (leave empty to disable)
SENTRY_DSN=

# ---- Background jobs -----------------------------------------------------------
# Trend refresh cadence (hours)
DEFAULT_TREND_NICHE=technology
TREND_CACHE_HOURS=24

# ---- Offline eval gate ---------------------------------------------------------
# auto = report-only on free-tier chains (never fails CI), enforce = fail below score
EVAL_MODE=auto
EVAL_MIN_SCORE=7.0
EVAL_THRESHOLD=7.0
