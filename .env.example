# Runtime environment: development | production (production refuses to boot with weak/empty API_KEY)
APP_ENV=development

# LLM provider (anthropic | gemini). Zero-cost default: gemini free tier + optional Groq free tier.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_WRITER=gemini-3.8-flash
# Ordered fallback chain for every role (free-tier Flash / Flash-Lite models).
# Tried in order on 503/429/timeout; a daily-quota 429 puts that model in cooldown until Retry-After.
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash-lite
# Optional second free provider (last resort). Leave GROQ_API_KEY empty to skip silently.
# https://console.groq.com -> API Keys (free tier, no card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_REQUESTS_PER_MINUTE=8
LLM_MAX_CONCURRENCY=2
LLM_CACHE_TTL_SECONDS=3600
GEMINI_REQUEST_TIMEOUT_SECONDS=90

# Free-tier guards
GENERATION_DAILY_LIMIT_PER_USER=20
EVAL_MIN_SCORE=7.0
EVAL_MODE=auto
# Qdrant vector database. Leave empty to use the in-memory fallback (data will not persist).
# Get your URL + API key in Qdrant Cloud -> Clusters -> your cluster -> API Keys.
# Self-hosted: QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=ysg
# Current Gemini text embedding model (gemini-embedding-2, stable since April 2026)
EMBEDDING_MODEL=gemini-embedding-2
# Cheaper model for outline + critic, stronger model for the writer
LLM_OUTLINE_MODEL=claude-3-haiku-20240307
LLM_CRITIC_MODEL=claude-3-haiku-20240307
LLM_WRITER_MODEL=claude-sonnet-4-20250514

# Generation
TEMPERATURE=0.7
MAX_REVISIONS=2
CRITIC_PASS_THRESHOLD=8.0
TARGET_WPM=140
AGENT_TIMEOUT_SECONDS=300

# API key auth — generate a strong key with `python scripts/generate_secret.py` (>= 32 random chars)
API_KEY=

# CORS: comma-separated allowed origins (never "*" in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

# Observability / storage
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/youtube_script_generator.db

# Trend detection scheduler
DEFAULT_TREND_NICHE=technology
TREND_CACHE_HOURS=24

# Offline eval gate (Phase 4): fail CI if average judge score drops below threshold
EVAL_THRESHOLD=7.0

# TTS (Phase 3 item 6) - provider: elevenlabs | edge (free local option)
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
TTS_VOICE=pNInz6obpgDQGcFmaJgB

# Stripe billing (absent key -> 501 "not configured")
STRIPE_API_KEY=

# Translation / dubbing supported languages (Phase 3 item 5)
SUPPORTED_LANGUAGES=English,Urdu,Roman Urdu,Hindi,Arabic,Spanish
